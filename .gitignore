# 로컬 전용 (CLAUDE.md 규칙)
.claude/
CLAUDE.md

# 의존성
node_modules/

# 빌드 산출물
dist/
out/

# 실험용 브랜치를 별도 git worktree 로 격리할 때(다른 세션과 같은 작업 디렉토리를
# 공유하다 충돌한 적 있어 도입) 여기 밑에 둔다 — 각 워크트리 자체는 독립된 git 상태를
# 가지므로 루트 저장소 쪽에서는 통째로 무시한다.
.worktrees/
# build/ 는 electron-builder 관례상 앱 아이콘 등 소스 에셋도 두는 폴더라 통째로 무시하지
# 않고 내용물만 무시 + 필요한 파일만 예외 처리한다(디렉터리 자체를 무시하면 예외 패턴이
# 안 먹힌다).
build/*
!build/icon.png

# 환경 변수 / 시크릿
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Tesseract.js 언어팩 캐시 (실행 중 자동 다운로드됨)
*.traineddata

# 실험용 브랜치(experiment/doclayout-yolo) — Python venv 와 다운로드되는 모델
# 가중치는 크고 재생성 가능해서 커밋하지 않는다(python/README.md 참고).
python/.venv/
python/__pycache__/

# 로컬 사전 번들(OEWN/JMdict/CC-CEDICT, 총 94MB) — 커밋 대신 스크립트로 재생성한다.
# npm run dev/build 시 scripts/ensure-resources.sh 가 없으면 자동으로 채운다(README.md
# "사전 데이터 준비" 참고).
resources/


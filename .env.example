# 개발 전용 API 키 (electron-vite: MAIN_VITE_ 접두사만 main 프로세스에 노출)
# 이 파일을 .env 로 복사한 뒤 실제 키를 채운다. .env 는 .gitignore 대상.

# 지금은 OpenAI 만 채워서 실험. 나머지는 비워두면 seed 되지 않음.
MAIN_VITE_OPENAI_API_KEY=
MAIN_VITE_GEMINI_API_KEY=
MAIN_VITE_CLAUDE_API_KEY=

# 활성 provider (gpt | gemini | claude) — 내부 LlmProvider 값과 동일해야 함(env 변수명
# 자체는 하위 호환을 위해 MAIN_VITE_OPENAI_API_KEY 그대로 두지만, 이 값은 'gpt').
# 미지정 시 활성 provider 없음(설정에서 선택).
MAIN_VITE_ACTIVE_PROVIDER=

# Merriam-Webster 사전 API(PLAN.md §5) — dictionaryapi.com 에서 무료 개인용 키 발급.
# Dictionary(Collegiate)/Learner's 두 사전이 키가 따로 발급됨.
MAIN_VITE_MW_DICTIONARY_KEY=
MAIN_VITE_MW_LEARNERS_KEY=

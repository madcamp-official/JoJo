# 개발 전용 API 키 (electron-vite: MAIN_VITE_ 접두사만 main 프로세스에 노출)
# 이 파일을 .env 로 복사한 뒤 실제 키를 채운다. .env 는 .gitignore 대상.

MAIN_VITE_GPT_API_KEY=
MAIN_VITE_GEMINI_API_KEY=
MAIN_VITE_CLAUDE_API_KEY=

# 활성 provider (gpt | gemini | claude) — 내부 LlmProvider 값과 동일해야 함.
# 미지정 시 활성 provider 없음(설정에서 선택).
MAIN_VITE_ACTIVE_PROVIDER=

# Merriam-Webster 사전 API(PLAN.md §5) — dictionaryapi.com 에서 Collegiate 사전으로
# 무료 개인용 키 발급(Learner's 등 다른 사전 키는 쓰지 않음).
MAIN_VITE_MW_COLLEGIATE_KEY=

# Python OCR 엔진(PyInstaller freeze 번들, nuance-py-main/nuance-py-ndlocr) 배포 위치.
# 릴리스 워크플로가 R2에 올린 뒤 이 base URL 아래 <version>/<파일명> 경로로 받는다
# (scripts/build-python-engines.sh, src/main/selection/pythonEngineInstall.ts 참고).
# 미지정 시 개발 모드는 영향 없음(로컬 venv를 그대로 씀) — 패키지된 빌드에서만 쓰인다.
MAIN_VITE_PY_ENGINE_BASE_URL=

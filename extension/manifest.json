{
  "manifest_version": 3,
  "name": "Nuance",
  "version": "0.0.1",
  "description": "브라우저에서 자막/DOM 텍스트를 추출해 Nuance 데스크톱 앱과 통신한다.",
  "permissions": ["activeTab", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.netflix.com/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["networkHook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflixNetworkHook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
